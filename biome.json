{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!scratch"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noTemplateCurlyInString": "off",
        "noExplicitAny": "off"
      },
      "complexity": {
        "noCommaOperator": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnsafeOptionalChaining": "off",
            "useYield": "off",
            "noUnusedImports": "off",
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off",
            "noChildrenProp": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off",
            "noControlCharactersInRegex": "off",
            "useIterableCallbackReturn": "off",
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/vscode/webview/**", "packages/robot/skins/**"],
      "linter": {
        "rules": {
          "a11y": "off",
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    },
    {
      "includes": ["**/config/**", "**/config.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/vscode/webview/App.tsx",
        "packages/vscode/webview/activity.tsx",
        "packages/vscode/webview/timeline.tsx"
      ],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/vscode/assets/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
